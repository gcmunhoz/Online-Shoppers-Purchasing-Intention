# CLI
# --------------------------------------------------------------------------- #
def test_cli_accepts_mlflow_flags(pipeline_module, fast_search, shoppers_csv, tmp_path,
                                  monkeypatch, isolated_mlflow):
    out_path = tmp_path / "cli" / "modelo.joblib"
    monkeypatch.setattr(sys, "argv", ["model.py", "--csv", str(shoppers_csv),
                                      "--out", str(out_path),
                                      "--experiment", "exp-cli",
                                      "--run-name", "run-cli",
                                      "--no-register"])

    runpy.run_path(str(Path(pipeline_module.__file__)), run_name="__main__")

    client = MlflowClient(tracking_uri=isolated_mlflow)
    experiment = client.get_experiment_by_name("exp-cli")
    assert experiment is not None
    runs = client.search_runs([experiment.experiment_id])
    assert len(runs) == 1
    assert runs[0].data.tags["mlflow.runName"] == "run-cli"
    assert len(_versions(client, pipeline_module)) == 0