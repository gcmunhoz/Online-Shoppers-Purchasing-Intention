def test_model_is_registered(trained, pipeline_module):
    assert len(_versions(trained.client, pipeline_module)) == 1


def test_registered_model_loads_and_predicts(trained, pipeline_module, tmp_path):
    mlflow.set_tracking_uri(trained.uri)
    model = mlflow.sklearn.load_model(f"models:/{pipeline_module.MLFLOW_MODEL_NAME}/1")

    new_csv = tmp_path / "novas.csv"
    make_shoppers_df(n=200, seed=7, n_duplicates=0).to_csv(new_csv, index=False)
    df = pipeline_module.load_data(str(new_csv))
    X = df[pipeline_module.NUMERIC_COLS + pipeline_module.CATEGORICAL_COLS
           + pipeline_module.BINARY_COLS]

    pred = model.predict(X)
    assert len(pred) == len(X)
    assert set(np.unique(pred)) <= {0, 1}

    # Quando o limiar foi embutido, `predict` deve usá-lo (e não o corte de 0,5)
    if trained.run.data.tags["model.applies_threshold"] == "True":
        threshold = trained.run.data.metrics["decision_threshold"]
        expected = (model.predict_proba(X)[:, 1] >= threshold).astype(int)
        assert (pred == expected).all()


def test_no_register_flag_skips_registry(pipeline_module, fast_search, shoppers_csv,
                                         tmp_path, isolated_mlflow):
    pipeline_module.main(str(shoppers_csv), str(tmp_path / "m.joblib"), register_model=False)

    client = MlflowClient(tracking_uri=isolated_mlflow)
    assert len(_versions(client, pipeline_module)) == 0


def test_each_run_creates_a_new_model_version(pipeline_module, fast_search, shoppers_csv,
                                              tmp_path, isolated_mlflow):
    pipeline_module.main(str(shoppers_csv), str(tmp_path / "a.joblib"))
    pipeline_module.main(str(shoppers_csv), str(tmp_path / "b.joblib"))

    client = MlflowClient(tracking_uri=isolated_mlflow)
    assert len(_versions(client, pipeline_module)) == 2


