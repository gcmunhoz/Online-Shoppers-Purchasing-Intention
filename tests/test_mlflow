def test_custom_experiment_and_run_name(pipeline_module, fast_search, shoppers_csv,
                                        tmp_path, isolated_mlflow):
    run_id = pipeline_module.main(str(shoppers_csv), str(tmp_path / "m.joblib"),
                                  experiment_name="exp-teste", run_name="minha-run")

    client = MlflowClient(tracking_uri=isolated_mlflow)
    run = client.get_run(run_id)
    assert run.data.tags["mlflow.runName"] == "minha-run"
    assert client.get_experiment(run.info.experiment_id).name == "exp-teste"


def test_explicit_tracking_uri_beats_environment(pipeline_module, fast_search, shoppers_csv,
                                                 tmp_path, isolated_mlflow):
    other = f"sqlite:///{(tmp_path / 'outro' / 'mlflow.db').as_posix()}"
    run_id = pipeline_module.main(str(shoppers_csv), str(tmp_path / "m.joblib"),
                                  tracking_uri=other)

    assert MlflowClient(tracking_uri=other).get_run(run_id).info.status == "FINISHED"
    with pytest.raises(Exception):  # a run não existe no banco da variável de ambiente
        MlflowClient(tracking_uri=isolated_mlflow).get_run(run_id)


def test_artifacts_are_stored_next_to_the_database(trained):
    experiment = trained.client.get_experiment(trained.run.info.experiment_id)

    assert "mlflow_store" in experiment.artifact_location
    assert "artifacts" in experiment.artifact_location


def test_no_stray_mlflow_folders_in_cwd(pipeline_module, fast_search, shoppers_csv,
                                        tmp_path, monkeypatch):
    work = tmp_path / "work"
    work.mkdir()
    monkeypatch.chdir(work)

    pipeline_module.main(str(shoppers_csv), str(tmp_path / "m.joblib"))

    assert not (work / "mlruns").exists()
    assert not (work / "mlartifacts").exists()


def test_failed_training_marks_run_as_failed(pipeline_module, fast_search, shoppers_csv,
                                             tmp_path, monkeypatch, isolated_mlflow):
    def boom(*args, **kwargs):
        raise RuntimeError("falha de teste")

    monkeypatch.setattr(pipeline_module, "choose_threshold", boom)
    with pytest.raises(RuntimeError):
        pipeline_module.main(str(shoppers_csv), str(tmp_path / "m.joblib"))

    client = MlflowClient(tracking_uri=isolated_mlflow)
    experiment = client.get_experiment_by_name(pipeline_module.MLFLOW_EXPERIMENT)
    runs = client.search_runs([experiment.experiment_id])
    assert len(runs) == 1
    assert runs[0].info.status == "FAILED"


