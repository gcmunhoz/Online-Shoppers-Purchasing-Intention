"""Testes da integração com o MLflow.

Cada teste usa um banco SQLite próprio em tmp_path (fixture autouse
`isolated_mlflow` do conftest), então nada é gravado em <raiz>/mlflow_data.
"""
import hashlib
import runpy
import sys
from pathlib import Path
from types import SimpleNamespace

import joblib
import numpy as np
import pytest

mlflow = pytest.importorskip("mlflow")
from mlflow import MlflowClient  # noqa: E402

from conftest import PROJECT_ROOT, make_shoppers_df  # noqa: E402


@pytest.fixture
def trained(pipeline_module, fast_search, shoppers_csv, tmp_path, isolated_mlflow):
    """Roda o pipeline uma vez e devolve a run já lida do MLflow."""
    out = tmp_path / "modelo.joblib"
    run_id = pipeline_module.main(str(shoppers_csv), str(out))
    client = MlflowClient(tracking_uri=isolated_mlflow)
    return SimpleNamespace(run_id=run_id, run=client.get_run(run_id), client=client,
                           uri=isolated_mlflow, out=out, csv=shoppers_csv)


def _versions(client, pipeline_module):
    return client.search_model_versions(f"name='{pipeline_module.MLFLOW_MODEL_NAME}'")


# --------------------------------------------------------------------------- #
# Configuração
# --------------------------------------------------------------------------- #
def test_default_tracking_uri_points_to_project_root(pipeline_module):
    uri = pipeline_module.MLFLOW_TRACKING_URI

    assert uri.startswith("sqlite:///")
    assert Path(uri[len("sqlite:///"):]) == PROJECT_ROOT / "mlflow_data" / "mlflow.db"


def test_file_md5_matches_hashlib(pipeline_module, tmp_path):
    path = tmp_path / "x.bin"
    path.write_bytes(b"conteudo de teste" * 1000)

    assert pipeline_module.file_md5(path) == hashlib.md5(path.read_bytes()).hexdigest()


# --------------------------------------------------------------------------- #
# O que é registrado na run
# --------------------------------------------------------------------------- #
def test_run_finishes_in_default_experiment(trained, pipeline_module):
    assert trained.run.info.status == "FINISHED"
    experiment = trained.client.get_experiment(trained.run.info.experiment_id)
    assert experiment.name == pipeline_module.MLFLOW_EXPERIMENT


def test_run_logs_expected_params(trained):
    params = trained.run.data.params

    for key in ["random_state", "test_size", "cv_splits", "n_iter", "scoring",
                "n_rows_raw", "n_rows_dedup", "n_train", "n_test", "n_features"]:
        assert key in params, f"param ausente: {key}"
    assert params["random_state"] == "42"
    assert params["test_size"] == "0.2"
    assert int(params["n_train"]) + int(params["n_test"]) == int(params["n_rows_dedup"])
    assert int(params["n_rows_raw"]) > int(params["n_rows_dedup"])  # havia duplicatas
    # hiperparâmetros escolhidos pela busca
    assert any(k.startswith("rf__") for k in params)


def test_run_logs_expected_metrics(trained):
    metrics = trained.run.data.metrics

    unit_interval = ["test_roc_auc", "test_pr_auc", "test_f1", "test_precision",
                     "test_recall", "test_accuracy", "decision_threshold",
                     "cv_pr_auc_mean", "positive_rate_train", "positive_rate_test"]
    for key in unit_interval:
        assert key in metrics, f"métrica ausente: {key}"
        assert 0.0 <= metrics[key] <= 1.0, f"{key} fora de [0, 1]"


def test_confusion_counts_add_up_to_test_size(trained):
    m = trained.run.data.metrics
    total = m["test_tn"] + m["test_fp"] + m["test_fn"] + m["test_tp"]

    assert total == int(trained.run.data.params["n_test"])


def test_run_tags_the_exact_dataset(trained):
    tags = trained.run.data.tags

    assert tags["dataset.file"] == trained.csv.name
    assert tags["dataset.md5"] == hashlib.md5(trained.csv.read_bytes()).hexdigest()


def test_logged_threshold_matches_saved_joblib(trained):
    saved = joblib.load(trained.out)

    assert trained.run.data.metrics["decision_threshold"] == pytest.approx(saved["threshold"], abs=1e-9)


def test_run_logs_artifacts(trained):
    def paths(folder):
        return {f.path for f in trained.client.list_artifacts(trained.run_id, folder)}

    assert "reports/classification_report.txt" in paths("reports")
    assert "reports/feature_importances.csv" in paths("reports")
    assert "tuning/cv_results.csv" in paths("tuning")
    assert f"joblib/{trained.out.name}" in paths("joblib")


