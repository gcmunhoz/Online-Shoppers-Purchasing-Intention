# Copie para `.env` e ajuste conforme o ambiente: cp .env.example .env
# Variáveis definidas no ambiente têm prioridade sobre este arquivo.

# Backend do MLflow. Vazio = SQLite em <raiz>/mlflow_data/mlflow.db
# (SQLite é necessário para o Model Registry). Ex.: http://localhost:5000
MLFLOW_TRACKING_URI=

# Experimento onde as runs são registradas
MLFLOW_EXPERIMENT_NAME=online-shoppers-purchase-intention

# Model Registry: nome do modelo, se cada run registra uma versão,
# alias da melhor versão e métrica (maior = melhor) usada para escolhê-la
MLFLOW_MODEL_NAME=rf_online_shoppers
MLFLOW_REGISTER_MODEL=true
MLFLOW_CHAMPION_ALIAS=champion
MLFLOW_SELECTION_METRIC=test_pr_auc
